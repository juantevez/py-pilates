# Proxy HTTPS de producción (docker-compose.prod.yml).
# Caddy obtiene y renueva solo el certificado de Let's Encrypt para {$DOMAIN}, y redirige HTTP → HTTPS.
# Un único origen: el front en / y la API en /api (sin CORS en el navegador).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# El navegador recuerda por un año que este dominio sólo va por HTTPS.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# /api/auth/login → api:8000/auth/login. Caddy reemplaza X-Forwarded-For con la IP real
	# del cliente (no confía en la que manda el cliente), y el rate limiting la usa.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}
