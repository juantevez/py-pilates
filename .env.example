# --- Infraestructura ---
DATABASE_URL=postgresql+psycopg://pilates:pilates@db:5432/pilates
REDIS_URL=redis://redis:6379/0
# Pool por proceso de la API (con WEB_CONCURRENCY workers: workers × (pool + overflow) conexiones)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Procesos de uvicorn (en docker-compose el default es 4)
# WEB_CONCURRENCY=4
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
TIMEZONE=America/Argentina/Buenos_Aires
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Admin inicial (se crea al levantar la API si no existe) ---
ADMIN_EMAIL=admin@pilates.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Recepción

# --- Grilla ---
CLASS_CAPACITY=4
CLASS_DURATION_MINUTES=60
MORNING_SLOTS=08:00,09:00,10:00,11:00
AFTERNOON_SLOTS=15:00,16:00,17:00

# --- Reglas de negocio ---
BOOKING_OPENING_TIME=20:00
ALLOW_SAME_DAY_BOOKING=true
MIN_BOOKING_ADVANCE_MINUTES=0
CANCEL_MIN_NOTICE_MINUTES=60
MAX_BOOKINGS_PER_DAY=2
MAX_BOOKINGS_PER_BLOCK=1

# --- Notificaciones ---
REMINDER_HOURS_BEFORE=12
NOTIFY_CLOSED_DAY=true
EVENT_BUS=celery
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM=Pilates Studio <no-reply@pilates.local>
PASSWORD_RESET_TTL_MINUTES=60

# --- Rate limiting (login, registro y recuperación de contraseña) ---
RATE_LIMIT_ENABLED=true
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=20
LOGIN_FAILURES_PER_EMAIL=5
LOGIN_FAILURE_WINDOW_MINUTES=15
REGISTRATIONS_PER_IP_PER_HOUR=10
PASSWORD_RESETS_PER_IP_PER_HOUR=5
PASSWORD_RESETS_PER_EMAIL_PER_HOUR=3
